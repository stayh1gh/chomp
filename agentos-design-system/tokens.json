      "lineHeight": { "14": "14", "16": "16", "20": "20", "25": "25", "30": "30", "160pct": "160%" },
      "fontWeight": { "regular": "400", "medium": "500", "semibold": "600" },
      "fontFamily": { "default": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" }
    },
    "styles": {
      "display":        { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "24", "fontWeight": "600", "lineHeight": "30" },
      "heading":         { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "20", "fontWeight": "600", "lineHeight": "25" },
      "heading-sm":      { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "16", "fontWeight": "600", "lineHeight": "20" },
      "label-lg":        { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "16", "fontWeight": "500", "lineHeight": "20" },
      "nav-item":        { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "16", "fontWeight": "400", "lineHeight": "20" },
      "body-lg":         { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "16", "fontWeight": "500", "lineHeight": "160%" },
      "title":           { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "14", "fontWeight": "500", "lineHeight": "20" },
      "body":            { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "14", "fontWeight": "400", "lineHeight": "20" },
      "label":           { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "13", "fontWeight": "400", "lineHeight": "16" },
      "caption-strong":  { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "12", "fontWeight": "500", "lineHeight": "16" },
      "caption":         { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "12", "fontWeight": "400", "lineHeight": "16" },
      "overline":        { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "12", "fontWeight": "600", "lineHeight": "16" },
      "micro":           { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "11", "fontWeight": "400", "lineHeight": "14" },
      "nano":            { "fontFamily": "{typography.primitives.fontFamily.default}", "fontSize": "10", "fontWeight": "400", "lineHeight": "14" }
    }
  },
  "spacing": {
    "space-2": "2", "space-4": "4", "space-6": "6", "space-8": "8", "space-10": "10",
    "space-12": "12", "space-14": "14", "space-16": "16", "space-20": "20",
    "space-24": "24", "space-28": "28", "space-32": "32", "space-48": "48"
  },
  "radius": {
    "none": "0", "sm": "5", "md": "6", "lg": "8", "pill": "48", "full": "9999"
  },
  "borderWidth": {
    "width-default": "1", "width-focus": "2"
  },
  "focusOffset": "1",
  "iconSize": {
    "xs": "13", "sm": "14", "md": "16", "lg": "18", "xl": "20"
  },
  "semantic": {
    "color": {
      "canvas": "{surface.surface-0}",
      "surface": "{surface.surface-1}",
      "surface-card": "{surface.surface-2}",
      "surface-inset": "{surface.surface-3}",
      "accent-tile": "{surface.surface-accent-tile}",
      "border": "{surface.surface-border}",
      "border-strong": "{surface.surface-border-strong}",
      "border-hover": "{componentFlat.border-hover}",
      "divider": "{surface.surface-divider}",
      "ink": "{text.text-0}",
      "ink-strong": "{text.text-1}",
      "ink-body": "{text.text-3}",
      "ink-muted": "{text.text-4}",
      "ink-subtle": "{text.text-5}",
      "ink-nav": "{text.text-6}",
      "ink-faint": "{text.text-7-a11y}",
      "ink-disabled": "{text.text-8}",
      "ink-inverse": "{text.text-0}",
      "ink-on-status": "{text.ink-on-status-fill}",
      "brand": "{indigo.500}",
      "success": "{green.500}",
      "warning": "{orange.500}",
      "danger": "{red.500}",
      "approve": "{approve.approve-text-a11y}"
