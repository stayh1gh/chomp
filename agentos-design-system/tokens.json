    "component": {
      "bg-brand-default": "{indigo.500}",
      "bg-secondary-default": "{componentFlat.bg-secondary}",
      "bg-secondary-default-hovered": "{componentFlat.bg-secondary-hover}",
      "bg-ghost-default-hovered": "{componentFlat.bg-ghost-hover}",
      "bg-approve-ghost-hovered": "{approve.approve-hover-tint}",
      "bg-input": "{componentFlat.bg-input}",
      "icon-default": "{text.text-5}",
      "icon-muted": "{text.text-4}",
      "focus-ring": "{indigo.500}",
      "sidebar-item-hovered-bg": "{componentFlat.sidebar-item-hover-bg}",
      "sidebar-item-hovered-ink": "{text.text-2}",
      "sidebar-note-ink": "{componentFlat.sidebar-note-ink}"
    },
    "badge": {
      "bg-badge-running": "{green.500}",
      "ink-badge-running": "{text.ink-on-status-fill}",
      "bg-badge-approval": "{red.500}",
      "ink-badge-approval": "{text.ink-on-status-fill}",
      "bg-badge-user": "{orange.500}",
      "ink-badge-user": "{text.ink-on-status-fill}",
      "bg-badge-done": "{indigo.500}",
      "ink-badge-done": "{text.text-0}",
      "bg-badge-outline": "{surface.surface-2}",
      "border-badge-outline": "{surface.surface-border-strong}",
      "ink-badge-outline": "{text.text-4}",
      "bg-badge-gate": "{statusPair.gate.bg}",
      "ink-badge-gate": "{statusPair.gate.ink}",
      "bg-badge-warn": "{statusPair.warn.bg}",
      "ink-badge-warn": "{statusPair.warn.ink}",
      "bg-badge-model": "{statusPair.model.bg}",
      "ink-badge-model": "{statusPair.model.ink}"
    },
    "toast": {
      "toast-danger-border": "{componentFlat.toast-danger-border}",
      "toast-danger-ink": "{componentFlat.toast-danger-ink}"
    }
