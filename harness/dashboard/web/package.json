{
  "name": "agentos-board-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Chomp board UI: React + Vite + Tailwind + shadcn/ui. Served by ../serve.mjs, which builds it and injects the write token; `npm run dev` serves it with HMR.",
  "scripts": {
    "dev": "node ../serve.mjs --dev --no-runner --port 4403",
    "build": "tsc -b && vite build",
    "bundle": "vite build --logLevel warn",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/nata-sans": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.50.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
